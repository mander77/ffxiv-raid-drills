// Configuration for Wrangler, the Cloudflare deploy tool. Cloudflare runs
// `npx wrangler deploy` after `npm run build`. Like tsconfig.json, this file allows comments.
{
  // Must match the project name in the Cloudflare dashboard.
  "name": "ffxiv-raid-drills",
  // The Workers runtime version to use. This site has no server code, so the date has no effect.
  "compatibility_date": "2026-11-18",
  // Serve the files that `npm run build` writes to dist/. No server code runs.
  "assets": {
    "directory": "./dist",
    // A page address with no file behind it, such as /learn/<card>, gets index.html, and React
    // Router reads the path in the browser. Real files, such as /assets/..., still come first.
    "not_found_handling": "single-page-application"
  },
  // Turns on preview deployments. Cloudflare runs `npx wrangler preview` for each branch
  // other than main, and that command stops if this block is missing. It can stay empty.
  "previews": {}
}
