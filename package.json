{
  "name": "ffxiv-raid-drills",
  "private": true,
  "description": "Practice drills for Final Fantasy XIV raids",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check",
    "format": "biome check --write",
    "import:sources": "node scripts/import-sources.mjs",
    "check:sources": "node scripts/import-sources.mjs --check && vitest run test/sources.test.ts",
    "publish": "node scripts/publish.mjs",
    "wait-deploy": "node scripts/wait-deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/saira-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0"
  }
}
