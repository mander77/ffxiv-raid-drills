{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "e2e/**",
      "scripts/**",
      "*.config.ts",
      "!src/data/*.ts",
      "!src/data/fights/m11s/*.ts",
      "src/data/fights/m11s/fightInfo.ts",
      "src/data/fights/m11s/reference.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": { "a11y": { "useSemanticElements": "off" }, "suspicious": { "noArrayIndexKey": "off" } }
      }
    },
    {
      "includes": ["src/**", "test/**", "e2e/**", "!src/components/icons.tsx", "!src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": { "lucide-react": "Import icons from src/components/icons.tsx, where each icon has a name by its meaning." }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
