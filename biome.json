{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/main.tsx",
      "src/App.tsx",
      "src/tabs.ts",
      "src/app.css",
      "src/components/**",
      "src/pages/**",
      "src/hooks/**",
      "src/stores/**",
      "src/lib/**",
      "test/components/**",
      "test/pages/**",
      "e2e/**",
      "vite.config.ts",
      "playwright.config.ts",
      "test/pictures.test.tsx",
      "test/stores/**",
      "test/lib/**",
      "test/hooks/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
